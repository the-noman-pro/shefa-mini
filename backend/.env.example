# Copy to backend/.env for local development. Real environments set these as environment variables instead.

# Required when DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=true

# Comma separated host names this server answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Unset = SQLite file backend/db.sqlite3. Postgres example:
# DATABASE_URL=postgres://shefa:shefa@localhost:5432/shefa
DATABASE_URL=

# Origins of the Vue app (scheme://host:port), comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origins allowed to POST forms with a CSRF cookie (the Django admin when served on another origin).
CSRF_TRUSTED_ORIGINS=

# Set both to true behind an HTTPS reverse proxy.
USE_X_FORWARDED_PROTO=false
SECURE_COOKIES=false

LOG_LEVEL=INFO
